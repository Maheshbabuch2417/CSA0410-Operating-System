#include <stdio.h>

struct emp
{
    int id;
    char name[20];
};

int main()
{
    FILE *fp;
    struct emp e={101,"Mahesh"};

    fp=fopen("emp.dat","wb+");

    fwrite(&e,sizeof(e),1,fp);

    rewind(fp);

    fread(&e,sizeof(e),1,fp);

    printf("ID : %d\n",e.id);
    printf("Name : %s\n",e.name);

    fclose(fp);

    return 0;
}
